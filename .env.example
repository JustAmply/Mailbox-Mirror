# Copy to .env and fill in these six values. Keep your existing .env on updates.
# Source mailbox
HOST1=imap.source.example
USER1=source@example.com
PASSWORD1='replace-me'

# Destination mailbox
HOST2=imap.destination.example
USER2=destination@example.com
PASSWORD2='replace-me'

# Optional: defaults already enable TLS and sync immediately, then every 5 minutes.
# DRY_RUN=true
# CRON_SCHEDULE=*/15 * * * *
# FOLDER_FILTER=INBOX
# HEALTHCHECK_MAX_AGE_MINUTES=30
# More settings: docs/configuration.md
# Multiple mailboxes: use .env.multi-mailbox.example instead.
