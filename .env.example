# Default setup
HOST1=imap.source.tld
PORT1=993
USER1=source-user@example.com
PASSWORD1=replace-me
SSL1=true
# AUTHMECH1=LOGIN

HOST2=imap.destination.tld
PORT2=993
USER2=target-user@example.com
PASSWORD2=replace-me
SSL2=true
# AUTHMECH2=LOGIN

CRON_SCHEDULE=*/5 * * * *
RUN_ON_STARTUP=true
DRY_RUN=false

# Optional tuning
# LOCK_FILE=/var/lock/mailbox-mirror/global.lock
# FOLDER_FILTER=INBOX
# MAXAGE_DAYS=30
# HEALTHCHECK_MAX_AGE_MINUTES=30
# IMAPSYNC_EXTRA_ARGS is split on whitespace. Avoid values that require shell quoting.
# IMAPSYNC_EXTRA_ARGS=--nofoldersizes
# MAX_LOG_SIZE_MB=10

# Advanced example for docker-compose.multi-mailbox.yml
# Uncomment the mailboxes you need. Reuse the same HOST2/USER2/PASSWORD2 values
# if all sources mirror into the same destination account.

# MAILBOX_A_HOST1=imap.mail.yahoo.com
# MAILBOX_A_PORT1=993
# MAILBOX_A_USER1=mailbox-a@yahoo.com
# MAILBOX_A_PASSWORD1=replace-me
# MAILBOX_A_SSL1=true
# MAILBOX_A_AUTHMECH1=LOGIN
# MAILBOX_A_HOST2=imap.gmail.com
# MAILBOX_A_PORT2=993
# MAILBOX_A_USER2=yourname@gmail.com
# MAILBOX_A_PASSWORD2=replace-me
# MAILBOX_A_SSL2=true
# MAILBOX_A_AUTHMECH2=LOGIN
# MAILBOX_A_DRY_RUN=false
# MAILBOX_A_MAXAGE_DAYS=30
# MAILBOX_A_IMAPSYNC_EXTRA_ARGS=

# MAILBOX_B_HOST1=imap.mail.yahoo.com
# MAILBOX_B_PORT1=993
# MAILBOX_B_USER1=mailbox-b@yahoo.com
# MAILBOX_B_PASSWORD1=replace-me
# MAILBOX_B_SSL1=true
# MAILBOX_B_AUTHMECH1=LOGIN
# MAILBOX_B_HOST2=imap.gmail.com
# MAILBOX_B_PORT2=993
# MAILBOX_B_USER2=yourname@gmail.com
# MAILBOX_B_PASSWORD2=replace-me
# MAILBOX_B_SSL2=true
# MAILBOX_B_AUTHMECH2=LOGIN
# MAILBOX_B_DRY_RUN=false
# MAILBOX_B_MAXAGE_DAYS=30
# MAILBOX_B_IMAPSYNC_EXTRA_ARGS=

# MAILBOX_C_HOST1=imap.mail.yahoo.com
# MAILBOX_C_PORT1=993
# MAILBOX_C_USER1=mailbox-c@yahoo.com
# MAILBOX_C_PASSWORD1=replace-me
# MAILBOX_C_SSL1=true
# MAILBOX_C_AUTHMECH1=LOGIN
# MAILBOX_C_HOST2=imap.gmail.com
# MAILBOX_C_PORT2=993
# MAILBOX_C_USER2=yourname@gmail.com
# MAILBOX_C_PASSWORD2=replace-me
# MAILBOX_C_SSL2=true
# MAILBOX_C_AUTHMECH2=LOGIN
# MAILBOX_C_DRY_RUN=false
# MAILBOX_C_MAXAGE_DAYS=30
# MAILBOX_C_IMAPSYNC_EXTRA_ARGS=

# Optional mounted secret files take precedence over PASSWORD1/PASSWORD2.
# PASSWORD1_FILE=/run/secrets/source_password
# PASSWORD2_FILE=/run/secrets/destination_password
# Multi-mailbox: MAILBOX_A_PASSWORD1_FILE, MAILBOX_A_PASSWORD2_FILE (also B/C).
# Mount these files into the matching service using a Compose override.

# Opt-in freshness and runtime limits; leave unset to preserve existing behavior.
# HEALTHCHECK_MAX_RUN_MINUTES=60
# RUN_TIMEOUT_SECONDS=3600
# SHUTDOWN_GRACE_SECONDS=10
# LOCK_WAIT_SECONDS=240
# Multi-mailbox: prefix these and HEALTHCHECK_MAX_AGE_MINUTES with MAILBOX_A_
# (or MAILBOX_B_ / MAILBOX_C_). Defaults stay unchanged.

# Folder selection/mapping: newline-separated values support spaces in names.
# FOLDER_INCLUDE='INBOX
# Sent Items'
# FOLDER_EXCLUDE=^Trash$
# FOLDER_MAP=Sent Items=Archive/Sent
# DESTINATION_PREFIX=Source/
# SYNC_MODE=additive
# ALLOW_DELETIONS=false
# SYNC_MODE=mirror additionally requires ALLOW_DELETIONS=true.
# Multi-mailbox: prefix new options with MAILBOX_A_ (also B/C).
# MAILBOX_A_FOLDER_FILTER=  # Empty disables the example's existing INBOX filter.
