# Copy to .env for a NEW multi-mailbox setup. Keep existing .env files on updates.
# This selects the multi-mailbox stack for ordinary `docker compose` commands.
COMPOSE_FILE=docker-compose.multi-mailbox.yml

# Fill only the mailboxes you use; start those services explicitly (see docs).
# Mailbox A -> destination
MAILBOX_A_HOST1=imap.source.example
MAILBOX_A_USER1=source-a@example.com
MAILBOX_A_PASSWORD1='replace-me'
MAILBOX_A_HOST2=imap.destination.example
MAILBOX_A_USER2=destination@example.com
MAILBOX_A_PASSWORD2='replace-me'

# Mailbox B -> destination (reuse A's destination values if appropriate)
MAILBOX_B_HOST1=imap.source.example
MAILBOX_B_USER1=source-b@example.com
MAILBOX_B_PASSWORD1='replace-me'
MAILBOX_B_HOST2=imap.destination.example
MAILBOX_B_USER2=destination@example.com
MAILBOX_B_PASSWORD2='replace-me'

# Mailbox C -> destination
MAILBOX_C_HOST1=imap.source.example
MAILBOX_C_USER1=source-c@example.com
MAILBOX_C_PASSWORD1='replace-me'
MAILBOX_C_HOST2=imap.destination.example
MAILBOX_C_USER2=destination@example.com
MAILBOX_C_PASSWORD2='replace-me'

# Defaults: INBOX only, staggered 15-minute schedules, no initial sync.
# Options and examples: docs/configuration.md#multiple-mailboxes
